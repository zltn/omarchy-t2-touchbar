+/// Where slider values are published. tiny-dfr does not apply them itself: it
+/// runs as `nobody` after PrivDrop and has no business talking to the user's
+/// PipeWire or backlight. A listener in the user session does that.
+const SLIDER_SOCKET: &str = "/run/tiny-dfr/slider.sock";
+
+/// Current value of a channel, as maintained by the listener. Returns 0.0 when
+/// unknown, which is the only sane default with nothing to read.
+fn read_slider_value(channel: &str) -> f64 {
+    std::fs::read_to_string(format!("/run/tiny-dfr/{}.value", channel))
+        .ok()
+        .and_then(|s| s.trim().parse::<f64>().ok())
+        .map(|v| v.clamp(0.0, 1.0))
+        .unwrap_or(0.0)
+}
+
+/// Best-effort, non-blocking, fire-and-forget. A missing or unreadable socket
+/// must never disturb drawing, so every error here is swallowed deliberately.
+fn publish_slider(channel: &str, value: f64) {
+    use std::os::unix::net::UnixDatagram;
+    let Ok(sock) = UnixDatagram::unbound() else {
+        return;
+    };
+    let _ = sock.set_nonblocking(true);
+    let _ = sock.send_to(format!("{} {:.4}", channel, value).as_bytes(), SLIDER_SOCKET);
+}
+
+fn rounded_rect(c: &Context, x: f64, y: f64, w: f64, h: f64, r: f64) {
+    let r = r.min(w / 2.0).min(h / 2.0);
+    c.new_sub_path();
+    c.arc(x + w - r, y + r, r, -std::f64::consts::FRAC_PI_2, 0.0);
+    c.arc(x + w - r, y + h - r, r, 0.0, std::f64::consts::FRAC_PI_2);
+    c.arc(x + r, y + h - r, r, std::f64::consts::FRAC_PI_2, std::f64::consts::PI);
+    c.arc(x + r, y + r, r, std::f64::consts::PI, 1.5 * std::f64::consts::PI);
+    c.close_path();
+}
