#!/bin/bash
# Record whether Omarchy updates are pending, for the Touch Bar update icon.
#
# This deliberately runs as the USER on a timer, not inside
# tiny-dfr-workspace.service, for three reasons:
#
#   1. omarchy-update-available calls checkupdates, which runs `pacman -Sy`
#      against a temp database and therefore needs the network. The daemon's
#      unit sets RestrictAddressFamilies=AF_UNIX, so the sync failed silently
#      inside the sandbox and the script honestly reported "up to date".
#   2. checkupdates should not be run as root.
#   3. It takes ~0.8s; the daemon should not block on it.
#
# The daemon just reads the one-byte state file, which costs nothing.
set -uo pipefail

STATE=/etc/tiny-dfr/update.state
export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"

if omarchy-update-available >/dev/null 2>&1; then
  value=1
else
  value=0
fi

tmp="${STATE}.tmp"
printf '%s\n' "$value" >"$tmp"
chmod 644 "$tmp"
mv -f "$tmp" "$STATE"
